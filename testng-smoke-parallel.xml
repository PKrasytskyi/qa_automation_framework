<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Parallel Methods Suite"
        parallel="methods"
        thread-count="2">

    <test name="Smoke Test">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="tests.ui.UserLoginTest"/>
            <class name="tests.ui.AddRemoveElementsTests"/>
            <class name="tests.ui.CheckboxesTests"/>
            <class name="tests.ui.DropDownTests"/>
            <class name="tests.ui.DynamicControlTests"/>
            <class name="tests.ui.DynamicLoadingTests"/>
            <class name="tests.ui.IFramesTests"/>
            <class name="tests.ui.InputsTest"/>
            <class name="tests.ui.JsAlertsTest"/>
            <class name="tests.ui.MultipleWindowsTests"/>
            <class name="tests.ui.NestedFramesTests"/>
        </classes>
    </test>
</suite>
